{
  "schemaVersion": 1,
  "id": "hotbar-scale",
  "version": "${version}",
  "name": "Hotbar Scale",
  "description": "Allows changing the Minecraft hotbar size.",
  "authors": [
    "Alihan"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.alihan.hotbarscale.HotbarScaleClient"
    ],
    "modmenu": [
      "com.alihan.hotbarscale.HotbarScaleModMenu"
    ]
  },
  "mixins": [
    {
      "config": "hotbar-scale.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}